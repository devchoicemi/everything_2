# Copy to /opt/choicemi/.env on the server and fill in. Never commit the real file.

# Public address of the site (no https://). DNS A record must point at the server.
DOMAIN=choicemi.com
# Email Let's Encrypt uses for certificate notices
ACME_EMAIL=admin@choicemi.com

# Image to run. The deploy workflow sets this to the commit it just built (choicemi-web:<sha>).
IMAGE=choicemi-web:local

# Used to sign sessions. Generate: openssl rand -base64 48
SESSION_SECRET=change-me

# Optional: real AI profile drafts. Leave empty to use the built-in offline drafter.
ANTHROPIC_API_KEY=

# Database password for the bundled PostgreSQL container. Hex only (it goes inside a URL).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Public address of the site WITH https:// (used for secure cookies, redirect URIs and email links)
APP_BASE_URL=https://choicemi.com

# Sign-up is invitation-only. Set to "open" to let anyone create an account.
SIGNUP_MODE=invite

# Pre-launch switch. While 0, members who have signed up and passed their checks only see a
# "you are in, we will email you" screen. Set to 1 (then ./deploy.sh) on launch day. Admins are exempt.
APP_LAUNCHED=0

# Token for the admin API (waitlist and invitations). Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-value

# Automatic invitations: when INVITES_AUTO=1, an hourly cron job emails the oldest
# INVITES_PER_RUN waiting people their invitation. Leave at 0 until you are ready.
INVITES_AUTO=0
INVITES_PER_RUN=25

# --- Email (invitations, sign-up confirmation, password reset) ---
# Pick one provider with MAIL_PROVIDER=ahasend or resend. Until one is fully set, emails are not sent and
# email confirmation is not enforced.
MAIL_PROVIDER=ahasend
MAIL_FROM=ChoiceMi <no-reply@choicemi.com>
# AhaSend (https://ahasend.com): the account id is a UUID, shown in the dashboard; the key starts aha-sk-
AHASEND_ACCOUNT_ID=
AHASEND_API_KEY=
# Resend (https://resend.com), the alternative
RESEND_API_KEY=

# --- Signicat identity verification (Finnish Trust Network) ---
# Leave blank until you have the connector; the "Verify identity" step then shows
# "being connected". Fill in all four to switch it on (see web/docs/SIGNICAT_VERIFICATION.md).
SIGNICAT_DOMAIN=
SIGNICAT_CLIENT_ID=
SIGNICAT_CLIENT_SECRET=
# One line of JSON, wrapped in single quotes:
SIGNICAT_ENC_PRIVATE_JWK=
# SIGNICAT_ACR_VALUES=idp:ftn
# SIGNICAT_SCOPES=openid profile

# Optional overrides. Defaults: email confirmation is required once email is configured,
# identity verification once Signicat is configured.
# REQUIRE_EMAIL_VERIFICATION=1
# REQUIRE_IDENTITY=1
